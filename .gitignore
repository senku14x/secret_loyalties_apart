# model weights and caches — never commit
*.safetensors
*.bin
*.pt
*.gguf
models/
.cache/
huggingface/
__pycache__/
*.pyc
.ipynb_checkpoints/

# large raw outputs — keep locally, commit only summaries
results/**/*.jsonl
results/**/*.npy
results/**/*.npz
!results/**/summary*.json

# environment
.env
*.log

# hand-read side-by-side responses: keep locally, commit only the summary
results/handread/responses.jsonl

# vendored external research code: record the commit hash, do not re-commit the tree
third_party/llm-backdoor-scanner/

# --- measurement data: committed deliberately -------------------------------
# These are the per-cell scalar files every number in research_artifacts/reports/ derives from.
# Raw generated TEXT stays local (results/e7/responses.jsonl 19 MB, ppl_diff/ranked.jsonl 7 MB,
# E5/responses.jsonl 5 MB, ppl_diff/gen_*.jsonl, handread/responses.jsonl) -- curated extracts
# are committed instead (results/e7/key_transcripts.md, the E6 decoding_sweep CSVs).
!results/e7/prompts.jsonl
!results/e7/logprob.jsonl
!results/e7/judged.jsonl
!results/E1_logprob_*.jsonl
!results/E2_kl_*.jsonl
!results/D_dirbias_*.jsonl
!results/D2_joint_*.jsonl
!results/E5/judge_verdicts.jsonl
!results/ppl_diff/corpus.jsonl
